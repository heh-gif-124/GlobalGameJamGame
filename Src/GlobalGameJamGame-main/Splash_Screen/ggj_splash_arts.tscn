[sub_resource type="GDScript" id="GDScript_k71jc"]
script/source = "# splash.gd - attach ke scene splash
extends Control

@export var next_scene: PackedScene
@export var fade_in_time: float = 1.0
@export var display_time: float = 2.0
@export var fade_out_time: float = 1.0

@onready var splash_texture: TextureRect = $TextureRect

func _ready():
	# Start fade sequence
	start_fade()

func start_fade():
	if not splash_texture:
		print(\"Error: No TextureRect found\")
		load_next_scene()
		return
	
	splash_texture.modulate.a = 0.0
	
	var tween = create_tween()
	tween.tween_property(splash_texture, \"modulate:a\", 1.0, fade_in_time)
	tween.tween_interval(display_time)
	tween.tween_property(splash_texture, \"modulate:a\", 0.0, fade_out_time)
	tween.tween_callback(load_next_scene)

func load_next_scene():
	if next_scene:
		get_tree().change_scene_to_packed(next_scene)
	else:
		get_tree().change_scene_to_file(\"res://MainMenu.tscn\")
"

